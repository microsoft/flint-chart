                  "stepWidth": {
                    "type": "number",
                    "description": "Jitter",
                    "minimum": 10,
                    "maximum": 100,
                    "multipleOf": 5,
                    "default": 20
                  },
                  "pointSize": {
                    "type": "number",
                    "description": "Size",
                    "minimum": 0,
                    "maximum": 150,
                    "multipleOf": 5,
                    "default": 0
                  },
                  "opacity": {
                    "type": "number",
                    "description": "Opacity",
                    "minimum": 0,
                    "maximum": 1,
                    "multipleOf": 0.1,
                    "default": 0
                  },
                  "independentYAxis": {
                    "type": "boolean",
                    "description": "Independent Y"
                  },
                  "logScale_x": {
                    "type": "boolean",
                    "description": "Log X",
                    "default": false
                  },
                  "logScale_y": {
                    "type": "boolean",
                    "description": "Log Y",
                    "default": false
                  },
                  "includeZero_x": {
                    "type": "boolean",
                    "description": "Zero X"
                  },
                  "includeZero_y": {
                    "type": "boolean",
                    "description": "Zero Y"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
