      "grid": false,
      "gridColor": "transparent",
      "gridWidth": 0,
      "domain": true,
      "domainColor": "#000000",
      "domainWidth": 1,
      "ticks": true,
      "tickColor": "#000000",
      "tickWidth": 1,
      "tickSize": 5,
      "labelFont": "Arial, Helvetica, sans-serif",
      "labelColor": "#000000",
      "labelPadding": 4,
      "titleFont": "Arial, Helvetica, sans-serif",
      "titleColor": "#000000",
      "titleFontWeight": "normal",
      "tickCount": 8
    },
    "axisY": {
