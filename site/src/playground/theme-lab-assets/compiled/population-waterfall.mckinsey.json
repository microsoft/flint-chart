      "labelColor": "#5a6872",
      "titleFont": "'Helvetica Neue', Helvetica, Arial, sans-serif",
      "titleColor": "#8a969d",
      "gradientLength": 200,
      "title": null
    },
    "facet": {
      "spacing": 23
    },
    "background": "#ffffff",
