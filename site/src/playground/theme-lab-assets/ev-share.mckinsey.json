      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": ["Norway", "China", "Germany", "United States"],
        "range": ["#051c2c", "#2251ff", "#00a9f4", "#3ebcb6"]
      }
    }
  },
  "layer": [
    {
      "mark": { "type": "rule", "color": "#051c2c", "strokeWidth": 1 },
      "encoding": { "y": { "datum": 0 }, "color": null }
    },
    { "mark": { "type": "line", "strokeWidth": 2.2 } },
    { "mark": { "type": "point", "filled": true, "size": 30 } },
    {
      "transform": [{ "filter": "utcyear(datum.Year) === 2023" }],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
