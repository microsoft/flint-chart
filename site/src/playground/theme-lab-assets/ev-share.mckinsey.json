        }
      }
    },
    {
      "transform": [{ "filter": "utcyear(datum.Year) === 2023" }],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "dy": 12,
        "fontSize": 10,
        "fontWeight": 400
      },
      "encoding": {
        "text": { "field": "EV share (%)", "type": "quantitative", "format": "d" }
      }
    }
  ],
  "config": {
