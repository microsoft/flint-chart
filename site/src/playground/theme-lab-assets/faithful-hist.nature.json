      "field": "Duration (min)",
      "type": "quantitative",
      "bin": { "step": 0.5, "extent": [1.5, 5] },
      "title": "Eruption duration (min)",
      "axis": { "format": ".1f", "tickCount": 8, "labelOverlap": "greedy" }
    },
