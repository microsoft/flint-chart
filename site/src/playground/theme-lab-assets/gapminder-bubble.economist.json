          { "Country": "Japan", "GDP per capita": 39300, "Life expectancy": 84.2, "Population (M)": 127, "Continent": "Asia" },
          { "Country": "China", "GDP per capita": 16800, "Life expectancy": 76.7, "Population (M)": 1393, "Continent": "Asia" },
          { "Country": "India", "GDP per capita": 6900, "Life expectancy": 69.4, "Population (M)": 1353, "Continent": "Asia" },
