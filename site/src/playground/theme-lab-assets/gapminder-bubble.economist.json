            "format": ".0f",
            "grid": true,
            "gridColor": "#dfe6ea",
            "labelPadding": 4,
            "titleAngle": 0,
            "titleAlign": "left",
            "titleAnchor": "start",
            "titleBaseline": "bottom",
            "titleY": -8,
            "titlePadding": 0
