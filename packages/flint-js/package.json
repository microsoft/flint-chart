{
  "name": "flint-chart",
  "version": "1.0.1",
  "description": "Semantic-level visualization library that compiles data + semantic types for Vega-Lite, ECharts, Chart.js, Plotly, and Excel.",
  "keywords": [
    "visualization",
    "charts",
    "vega-lite",
    "echarts",
    "chart.js",
    "semantic-types",
    "llm",
    "agent",
    "data-visualization"
  ],
  "license": "MIT",
  "author": "Microsoft Corporation",
  "homepage": "https://microsoft.github.io/flint-chart/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microsoft/flint-chart.git",
    "directory": "packages/flint-js"
  },
  "bugs": {
    "url": "https://github.com/microsoft/flint-chart/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./vegalite": {
      "types": "./dist/vegalite/index.d.ts",
      "import": "./dist/vegalite/index.js",
      "require": "./dist/vegalite/index.cjs"
    },
    "./echarts": {
      "types": "./dist/echarts/index.d.ts",
      "import": "./dist/echarts/index.js",
      "require": "./dist/echarts/index.cjs"
    },
    "./plotly": {
      "types": "./dist/plotly/index.d.ts",
      "import": "./dist/plotly/index.js",
      "require": "./dist/plotly/index.cjs"
    },
    "./chartjs": {
      "types": "./dist/chartjs/index.d.ts",
      "import": "./dist/chartjs/index.js",
      "require": "./dist/chartjs/index.cjs"
    },
    "./excel": {
      "types": "./dist/excel/index.d.ts",
      "import": "./dist/excel/index.js",
      "require": "./dist/excel/index.cjs"
    },
    "./image-charts": {
      "types": "./dist/image-charts/index.d.ts",
      "import": "./dist/image-charts/index.js",
      "require": "./dist/image-charts/index.cjs"
    },
    "./validate": {
      "types": "./dist/validate/index.d.ts",
      "import": "./dist/validate/index.js",
      "require": "./dist/validate/index.cjs"
    },
    "./interactive": {
      "types": "./dist/interactive/index.d.ts",
      "import": "./dist/interactive/index.js",
      "require": "./dist/interactive/index.cjs"
    },
    "./interactive/vegalite": {
      "types": "./dist/interactive/vegalite.d.ts",
      "import": "./dist/interactive/vegalite.js",
      "require": "./dist/interactive/vegalite.cjs"
    },
    "./interactive/echarts": {
      "types": "./dist/interactive/echarts.d.ts",
      "import": "./dist/interactive/echarts.js",
      "require": "./dist/interactive/echarts.cjs"
    },
    "./interactive/chartjs": {
      "types": "./dist/interactive/chartjs.d.ts",
      "import": "./dist/interactive/chartjs.js",
      "require": "./dist/interactive/chartjs.cjs"
    },
    "./interactive/plotly": {
      "types": "./dist/interactive/plotly.d.ts",
      "import": "./dist/interactive/plotly.js",
      "require": "./dist/interactive/plotly.cjs"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js",
      "require": "./dist/render/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./react/vegalite": {
      "types": "./dist/react/vegalite.d.ts",
      "import": "./dist/react/vegalite.js",
      "require": "./dist/react/vegalite.cjs"
    },
    "./react/echarts": {
      "types": "./dist/react/echarts.d.ts",
      "import": "./dist/react/echarts.js",
      "require": "./dist/react/echarts.cjs"
    },
    "./react/chartjs": {
      "types": "./dist/react/chartjs.d.ts",
      "import": "./dist/react/chartjs.js",
      "require": "./dist/react/chartjs.cjs"
    },
    "./react/plotly": {
      "types": "./dist/react/plotly.d.ts",
      "import": "./dist/react/plotly.js",
      "require": "./dist/react/plotly.cjs"
    },
    "./vegalite/interactive": {
      "types": "./dist/vegalite/interactive.d.ts",
      "import": "./dist/vegalite/interactive.js",
      "require": "./dist/vegalite/interactive.cjs"
    },
    "./echarts/interactive": {
      "types": "./dist/echarts/interactive.d.ts",
      "import": "./dist/echarts/interactive.js",
      "require": "./dist/echarts/interactive.cjs"
    },
    "./chartjs/interactive": {
      "types": "./dist/chartjs/interactive.d.ts",
      "import": "./dist/chartjs/interactive.js",
      "require": "./dist/chartjs/interactive.cjs"
    },
    "./plotly/interactive": {
      "types": "./dist/plotly/interactive.d.ts",
      "import": "./dist/plotly/interactive.js",
      "require": "./dist/plotly/interactive.cjs"
    },
    "./test-data": {
      "types": "./dist/test-data/index.d.ts",
      "import": "./dist/test-data/index.js",
      "require": "./dist/test-data/index.cjs"
    },
    "./gallery": {
      "types": "./dist/gallery/index.d.ts",
      "import": "./dist/gallery/index.js",
      "require": "./dist/gallery/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run test && npm run build",
    "release": "npm publish --access public"
  },
  "peerDependencies": {
    "chart.js": "^4.0.0",
    "echarts": "^5.0.0 || ^6.0.0",
    "plotly.js-dist-min": "^2.0.0 || ^3.0.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "chart.js": {
      "optional": true
    },
    "echarts": {
      "optional": true
    },
    "plotly.js-dist-min": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/d3-time": "^3.0.4",
    "@types/d3-time-format": "^4.0.3",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^9.15.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.16.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "js-yaml": "^4.2.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "vega": "^5.0.0 || ^6.0.0",
    "vega-lite": "^5.0.0 || ^6.0.0",
    "vega-tooltip": "^1.0.0"
  }
}
